{
  "name": "divas-black-whatsapp-integration",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.15.0 <25" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "receiver": "node --env-file-if-exists=.env src/receiver.ts",
    "setup:demo": "node scripts/setup-demo.ts",
    "schema": "node scripts/generate-schema.ts",
    "demo": "node --env-file-if-exists=.env scripts/demo.ts",
    "replay": "node --env-file-if-exists=.env scripts/replay.ts",
    "test:live": "node --env-file-if-exists=.env scripts/test-live.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start:built": "node --env-file-if-exists=.env dist/src/server.js"
  },
  "dependencies": { "express": "^5.1.0", "zod": "^4.1.0" },
  "devDependencies": { "@types/express": "^5.0.0", "@types/node": "^24.0.0", "typescript": "^5.9.0" }
}
