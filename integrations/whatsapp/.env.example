# Copie para .env. Nunca coloque segredos no Git.
PORT=3001
HOST=127.0.0.1
DATABASE_PATH=./data/whatsapp.sqlite
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Opcional: restringe ao número empresarial configurado no painel Meta.
WHATSAPP_PHONE_NUMBER_ID=
# Gere uma chave em https://console.groq.com/keys
GROQ_API_KEY=
# Modelo hospedado pela Groq com suporte a JSON Schema estrito.
GROQ_MODEL=openai/gpt-oss-20b
SALON_ADDRESS=
SOFTWARE_WEBHOOK_URL=http://127.0.0.1:3002/integrations/whatsapp/events
# Use o mesmo valor no servidor e no receptor de teste.
SOFTWARE_API_TOKEN=
RECEIVER_PORT=3002
RECEIVER_DATABASE_PATH=./data/receiver.sqlite
# Token de acesso da Meta é usado no painel/Postman para assinar a WABA;
# o servidor receptor não precisa dele para receber webhooks assinados.
