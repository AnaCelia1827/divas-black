      "css": ".ds-field{display:flex;flex-direction:column;gap:8px;font:600 16px var(--body);color:#111;min-width:0}.ds-field input{width:100%;min-height:52px;padding:12px 14px;border:1px solid #d4d2cd;background:#fff;border-radius:12px;color:#111;font:400 18px/1.4 var(--body);min-width:0;caret-color:#c90072}.ds-field input:focus{outline:3px solid #ff14933b;border-color:#c90072;outline-offset:2px}.ds-field input:disabled{background:#f4f3ef;color:#666}.ds-field input::placeholder{color:#71716b;font-size:16px}@media(max-width:560px){.ds-field{font-size:14px}.ds-field input{font-size:16px;padding:12px 10px}}"
