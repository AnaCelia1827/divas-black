{
  "name": "divas-black",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "whatsapp:install": "npm --prefix integrations/whatsapp ci",
    "whatsapp:setup": "npm --prefix integrations/whatsapp run setup:demo",
    "whatsapp:start": "npm --prefix integrations/whatsapp start",
    "whatsapp:receiver": "npm --prefix integrations/whatsapp run receiver",
    "whatsapp:demo": "npm --prefix integrations/whatsapp run demo",
    "whatsapp:replay": "npm --prefix integrations/whatsapp run replay --",
    "whatsapp:typecheck": "npm --prefix integrations/whatsapp run typecheck",
    "whatsapp:test": "npm --prefix integrations/whatsapp test",
    "whatsapp:test:live": "npm --prefix integrations/whatsapp run test:live",
    "whatsapp:build": "npm --prefix integrations/whatsapp run build"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.0",
    "@fontsource/space-grotesk": "^5.2.0",
    "@supabase/supabase-js": "^2.80.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
}
