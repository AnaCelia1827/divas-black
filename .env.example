# Opcional. Sem estas variáveis a interface usa a demonstração local no navegador.
# Para banco compartilhado, aplique supabase/migrations/001_demo_state.sql.
DATA_PROVIDER=demo
# Troque por DATA_PROVIDER=supabase somente após configurar o banco e as chaves.
SUPABASE_URL=https://seu-projeto.supabase.co
# Chave secret (sb_secret_...) ou service_role legada, SOMENTE servidor.
# Nunca use NEXT_PUBLIC_ para esta chave.
SUPABASE_SECRET_KEY=

# Assistente por texto: chave da Groq SOMENTE no servidor (sem NEXT_PUBLIC_).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
